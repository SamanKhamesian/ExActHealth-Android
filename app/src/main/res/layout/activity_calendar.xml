<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray">

    <RelativeLayout
        android:id="@+id/calendar_toolbar_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="20dp">

        <ImageView
            android:id="@+id/add_food_details_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/plus_button"
            android:gravity="center">
        </ImageView>

        <TextView
            android:id="@+id/calendar_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Calendar"
            android:textSize="16sp"
            android:textStyle="bold">
        </TextView>

    </RelativeLayout>

    <CalendarView
        android:id="@+id/calendar_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/calendar_toolbar_layout"
        android:layout_marginTop="30dp"
        android:background="@color/light_gray"
        android:theme="@style/DialogTheme">
    </CalendarView>

    <ListView
        android:id="@+id/calendar_food_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/calendar_widget"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:background="@color/light_gray"
        android:divider="@color/light_gray"
        android:dividerHeight="10dp"
        android:visibility="invisible" />

</RelativeLayout>